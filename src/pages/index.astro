---
import "../styles/global.css";
import BlenderLogo from "../components/BlenderLogo.astro";
import Footer from "../components/Footer.astro";
import InlineLink from "../components/InlineLink.astro";
import wordmark from "../assets/images/brand/wordmark.svg";
import wordmarkMobile from "../assets/images/brand/wordmark-mobile.svg";
import profileImage from "../assets/images/portraits/abdurahmaan-saloojee.jpg";
import socialImage from "../assets/images/social/og-image.png";
import Image from "astro/components/Image.astro";
const title = "Omniwerx®";
const description = "Omniwerx®: Precision-engineered websites & interfaces.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="oklch(0.117 0.003 27.557)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omniwerx®" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Omniwerx® web design and development"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Omniwerx® web design and development"
    />
  </head>
  <body>
    <main>
      <section id="hero">
        <div class="hero__wordmark">
          <div class="meta-row">omnx_01::<em>wordmark</em></div>
          <div class="hero__wordmark__container">
            <picture>
              <source
                media="(max-width: 991px)"
                srcset={wordmarkMobile.src}
                type="image/svg+xml"
                width={wordmarkMobile.width}
                height={wordmarkMobile.height}
              />
              <Image
                src={wordmark}
                alt="Omniwerx®"
                class="hero__wordmark__img"
              />
            </picture>
          </div>
        </div>
        <div class="hero__content">
          <div class="hero__content__lead">
            <div class="meta-row">
              omnx_02::<em>statement</em>
            </div>
            <h1>
              Omniwerx&reg; designs websites, builds product interfaces, and
              engineers internal systems for businesses that need faster
              solutions, better tools, and stronger visual identity.
            </h1>
          </div>
          <div class="hero__content__model">
            <div class="meta-row">
              omnx_03::<em>model</em>
            </div>
            <BlenderLogo />
          </div>
        </div>
      </section>
      <section id="details">
        <div class="details__about">
          <div class="meta-row">
            omnx_04::<em>capabilities</em>
          </div>
          <h2 class="details__title">What we do</h2>
          <p class="details__text">Some of the services we provide include:</p>
          <div class="details__list">
            <article class="details__list-item">
              <span class="list__index">01</span>
              <h3>Web development</h3>
            </article>
            <article class="details__list-item">
              <span class="list__index">02</span>
              <h3>Product/interface design</h3>
            </article>
            <article class="details__list-item">
              <span class="list__index">03</span>
              <h3>Backend integration</h3>
            </article>
            <article class="details__list-item">
              <span class="list__index">04</span>
              <h3>Marketing automation</h3>
            </article>
          </div>
        </div>
        <div class="details__services">
          <div class="meta-row">
            omnx_05::<em>engagements</em>
          </div>
          <h2 class="details__title">Custom website</h2>
          <div class="details__offer">
            <dl class="details__offer-specs">
              <div class="details__offer-term">
                <dt>Price</dt>
                <dd>From $3,000 USD</dd>
              </div>
              <div class="details__offer-term">
                <dt>Includes</dt>
                <dd>
                  Responsive design, performance optimization, CMS integration
                </dd>
              </div>
              <div class="details__offer-term">
                <dt>Delivery</dt>
                <dd>Within one week after scope approval</dd>
              </div>
            </dl>
            <p class="details__offer-action">
              <InlineLink href="mailto:info@omniwerx.io" arrow
                >Start a project</InlineLink
              >
            </p>
            <p class="details__offer-other">
              Have another project in mind, or interested in a retainer option?<br
              />
              <InlineLink href="mailto:info@omniwerx.io" arrow
                >Email us</InlineLink
              >
            </p>
          </div>
        </div>
        <div class="details__contact">
          <div class="meta-row">
            omnx_06::<em>company</em>
          </div>
          <h2 class="details__title">About Omniwerx&reg;</h2>
          <div class="details__founder">
            <Image
              src={profileImage}
              alt="Portrait of Abdurahmaan Saloojee"
              class="details__founder-headshot"
            />
            <div>
              <h3 class="details__founder-name">Abdurahmaan Saloojee</h3>
              <p class="details__founder-role">Founder</p>
            </div>
          </div>
          <p class="details__text">
            Omniwerx® is an independent software development consultancy based
            in Ottawa, Canada, founded and led by Abdurahmaan Saloojee.
          </p>
          <p class="details__text">
            You're not paying for a faceless agency. You work directly with the
            person building the project. That means less back-and-forth, faster
            iteration, and a solution tailored to your needs.
          </p>
          <p class="details__text">
            <InlineLink href="mailto:info@omniwerx.io" arrow
              >Start a project</InlineLink
            >
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
