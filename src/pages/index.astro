---
import "../styles/global.css";
import wordmark from "../assets/images/brand/wordmark.svg";
import socialImage from "../assets/images/social/og-image.png";
import InlineLink from "../components/InlineLink.astro";
const title = "Omniwerx®";
const description = "Omniwerx®: Precision-engineered websites & interfaces.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL(socialImage.src, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="oklch(0.117 0.003 27.557)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omniwerx®" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Omniwerx® web design and development"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Omniwerx® web design and development"
    />
  </head>
  <body class="wrapper">
    <main>
      <h1>
        <img
          class="wordmark"
          src={wordmark.src}
          width={wordmark.width}
          height={wordmark.height}
          alt="Omniwerx®"
        />
      </h1>
      <p class="tagline">Independent software development consultancy</p>
      <p class="lead">
        Omniwerx&reg; designs websites, builds product interfaces, and engineers
        internal systems for businesses that need faster solutions, better
        tools, and stronger visual identity. The consultancy is the project of
        Abdurahmaan Saloojee, a developer from Ottawa, Canada.
      </p>
      <section>
        <h2>What we do</h2>
        <p>Some of the services we provide include:</p>
        <ul>
          <li>Web development</li>
          <li>Product/interface design</li>
          <li>Backend integration</li>
          <li>Marketing automation</li>
        </ul>
      </section>
      <section>
        <h2>How we work</h2>
        <p>
          We work with clients in two ways: projects and retainers. Projects are
          for fixed engagements with a defined scope, and retainers are for
          open-ended engagements with a backlog of work.
        </p>
        <div class="project-link">
          <InlineLink href="mailto:info@omniwerx.io" arrow>
            Start a project
          </InlineLink>
        </div>
      </section>
    </main>
    <footer class="site-footer">&copy; 2026 Omniwerx Inc.</footer>
  </body>
</html>
