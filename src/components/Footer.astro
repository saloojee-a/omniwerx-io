---
import InlineLink from "./InlineLink.astro";
import { getGitCommitHash } from "../scripts/git-commit.js";

const { utilityOnly = false } = Astro.props;
const commitHash = getGitCommitHash();
---

<footer class="footer">
  {
    !utilityOnly && (
      <div class="footer__columns">
        <div class="footer__contact">
          <div class="meta-row">
            omnx_07::<em>contact</em>
          </div>
          <div class="footer__email">
            <InlineLink href="mailto:info@omniwerx.io" arrow>
              info@omniwerx.io
            </InlineLink>
          </div>
        </div>
        <div class="footer__socials">
          <div class="meta-row">
            omnx_08::<em>socials</em>
          </div>
          <nav class="footer__links" aria-label="Social links">
            <a
              href="https://www.github.com/asaloojee"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>GitHub</span>
            </a>
            <a
              href="https://www.instagram.com/saloojee_a"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Instagram</span>
            </a>
            <a
              href="https://www.linkedin.com/in/abdurahmaan-saloojee"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>LinkedIn</span>
            </a>
            <a
              href="https://www.x.com/saloojee_a"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>X</span>
            </a>
          </nav>
        </div>
      </div>
    )
  }
  <div class="footer__utility">
    <p class="footer__copyright">&copy; 2026 Omniwerx Inc.</p>
    <p>
      // build:&nbsp;
      <a
        href="https://github.com/asaloojee/omniwerx-io"
        title="Git commit"
        target="_blank"
        rel="noopener noreferrer"
      >
        <code>{commitHash}</code>
      </a>
    </p>
  </div>
</footer>

<style>
  footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    inline-size: min(calc(100% - 2rem), 1600px);
    margin-inline: auto;
    border-inline: var(--rule-vertical);
    box-shadow:
      inset 1px 0 0 var(--border-color--shadow),
      inset -1px 0 0 var(--border-color--shadow);
  }

  footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block-end: var(--rule-primary);
  }

  .footer__contact,
  .footer__socials {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .footer__contact {
    border-inline-end: var(--rule-primary);
    box-shadow: var(--rule-vertical-shadow);
  }

  .footer__email {
    display: flex;
    align-items: center;
    padding: 2rem 1rem;
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem 1rem;
  }

  .footer__links a {
    display: grid;
    place-items: center;
    min-inline-size: 2.5rem;
    min-block-size: 2.5rem;
    color: var(--white--primary);
    font-family: var(--font-mono);
    line-height: var(--leading-1);
  }

  .footer__utility {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1rem;
    color: var(--white--tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: var(--leading-mid);
  }

  .footer__copyright {
    color: var(--white--secondary);
  }

  .footer__utility code {
    font: inherit;
    font-size: 12px;
  }

  .footer__utility a {
    transition: color 400ms var(--bezier);
  }

  .footer__utility a:hover,
  .footer__utility a:focus-visible {
    color: var(--white--primary);
  }

  @media (max-width: 991px) {
    footer {
      inline-size: calc(100% - 1rem);
    }

    .footer__columns {
      grid-template-columns: minmax(0, 1fr);
    }

    .footer__contact {
      border-inline-end: 0;
      border-block-end: var(--rule-primary);
      box-shadow: none;
    }

    .footer__links {
      display: grid;
      gap: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(2, 1fr);
      padding: 0;
    }

    .footer__links a {
      padding: 1rem;
    }

    .footer__links a:nth-child(-n + 2) {
      border-block-end: var(--rule-primary);
    }

    .footer__links a:nth-child(odd) {
      border-inline-end: var(--rule-vertical);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__utility a {
      transition: none;
    }
  }
</style>
